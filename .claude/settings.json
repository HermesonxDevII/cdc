{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-gate.js\" prompt",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-gate.js\" stop",
            "timeout": 300,
            "statusMessage": "Rodando type-check e testes"
          }
        ]
      }
    ]
  }
}
